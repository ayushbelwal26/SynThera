{
  "buildCommand": "cd drug-combo-discovery/frontend && npm install && npm run build",
  "outputDirectory": "drug-combo-discovery/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://monsters-hearing-assure-librarian.trycloudflare.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
